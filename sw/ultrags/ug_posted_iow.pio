.program ug_posted_iow
.side_set 1 opt
restart:
.wrap_target
    wait 1 gpio 4
    wait 0 gpio 4
    jmp pin restart
    in pins, 10 side 1 [3]
    nop side 1 [3]
    in pins, 8 side 1
    nop side 0
    push block
.wrap
% c-sdk {
static inline void ug_posted_iow_program_init(PIO pio, uint sm, uint offset, float clkdiv) {
    pio_sm_config c = ug_posted_iow_program_get_default_config(offset);
    sm_config_set_in_pins(&c, 6);
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, clkdiv);
    sm_config_set_jmp_pin(&c, 19);
    sm_config_set_sideset_pins(&c, 27);
    pio_gpio_init(pio, 27);
    pio_sm_set_consecutive_pindirs(pio, sm, 27, 1, true);
    pio_sm_set_pins_with_mask(pio, sm, 0, 1u << 27);
    pio_sm_set_consecutive_pindirs(pio, sm, 4, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, 6, 10, false);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
.program ug_posted_iow_no_dack
.side_set 1 opt
restart:
.wrap_target
    wait 1 gpio 4
    wait 0 gpio 4
    nop
    in pins, 10 side 1 [3]
    nop side 1 [3]
    in pins, 8 side 1
    nop side 0
    push block
.wrap
% c-sdk {
static inline void ug_posted_iow_no_dack_program_init(PIO pio, uint sm, uint offset, float clkdiv) {
    pio_sm_config c = ug_posted_iow_no_dack_program_get_default_config(offset);
    sm_config_set_in_pins(&c, 6);
    sm_config_set_in_shift(&c, false, false, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, clkdiv);
    sm_config_set_jmp_pin(&c, 19);
    sm_config_set_sideset_pins(&c, 27);
    pio_gpio_init(pio, 27);
    pio_sm_set_consecutive_pindirs(pio, sm, 27, 1, true);
    pio_sm_set_pins_with_mask(pio, sm, 0, 1u << 27);
    pio_sm_set_consecutive_pindirs(pio, sm, 4, 1, false);
    pio_sm_set_consecutive_pindirs(pio, sm, 6, 10, false);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
