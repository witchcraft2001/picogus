# SPDX-License-Identifier: GPL-2.0-or-later
# Ultra GS build/test orchestration (S0a + S0b + S1).
#
# Required environment (see AGENTS.md):
#   PICO_SDK_PATH      Pico SDK 2.1.1 checkout
#   PICO_EXTRAS_PATH   pico-extras sdk-2.1.1 checkout
#   PATH               must contain arm-none-eabi-gcc 14.2.x
#   UG_PYTHON          Python 3 interpreter with sympy/scipy/more-itertools
#                      (needed by baseline table generators)
#
#   make -f Makefile.ultrags firmware     # MULTIFW + NE2K regression builds
#   make -f Makefile.ultrags diagnostic   # standalone diag, PGDEBUG=OFF + ON
#   make -f Makefile.ultrags host-test    # unit tests (+UBSan)
#   make -f Makefile.ultrags budgets      # SRAM/flash/settings/PIO tables
#
# S0b targets build and execute stage diagnostics. The production
# bundle and MAME/REAL hardware gates remain pending.

SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
# One stable build tree for every stage. Do not create per-run output roots.
override BUILD := $(ROOT)/build$(if $(filter 1,$(REPRODUCIBILITY)),/reproducibility)
SW := $(ROOT)/sw

PICO_SDK_PATH ?=
PICO_EXTRAS_PATH ?=
UG_PYTHON ?= python3
UG_AUDIO_PYTHON ?= $(UG_PYTHON)
UG_AUDIO_BASELINE ?=
UG_CONFIG_BASELINE ?=
UG_CONFIG_WAIT_BASELINE ?=
CC ?= cc
UG_PICOTOOL_SEED ?=
PICOTOOL_ROOT := $(abspath $(BUILD))/tools/picotool

export PICO_SDK_PATH PICO_EXTRAS_PATH

CMAKE_COMMON := -DCMAKE_BUILD_TYPE=Release \
	-DPython3_EXECUTABLE="$(UG_PYTHON)" \
	-Dpicotool_DIR="$(PICOTOOL_ROOT)/install/picotool"

define checkenv
	@if [ -z "$(PICO_SDK_PATH)" ] || [ -z "$(PICO_EXTRAS_PATH)" ]; then \
		echo "error: PICO_SDK_PATH/PICO_EXTRAS_PATH must be set" >&2; exit 2; \
	fi
	@command -v arm-none-eabi-gcc >/dev/null || { \
		echo "error: arm-none-eabi-gcc not in PATH" >&2; exit 2; }
	@"$(UG_PYTHON)" "$(ROOT)/tools/ultrags/preflight.py"
endef

.PHONY: prepare-tools firmware diagnostic diagnostic-release diagnostic-debug host-test \
        budgets clean fixtures dss test-dss package check

prepare-tools:
	$(checkenv)
	"$(UG_PYTHON)" "$(ROOT)/tools/ultrags/prepare_picotool.py" --root "$(PICOTOOL_ROOT)" \
		$(if $(UG_PICOTOOL_SEED),--seed "$(UG_PICOTOOL_SEED)")

firmware: prepare-tools
	$(checkenv)
	@mkdir -p $(BUILD)/multifw-release
	cmake -S $(SW) -B $(BUILD)/multifw-release $(CMAKE_COMMON) \
		-DPROJECT_TYPE=MULTIFW -DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_PSRAM_SCK_MHZ=100
	cmake --build $(BUILD)/multifw-release --parallel
	@mkdir -p $(BUILD)/ne2k-release
	cmake -S $(SW) -B $(BUILD)/ne2k-release $(CMAKE_COMMON) \
		-DPROJECT_TYPE=NE2K -DPICO_BOARD=picow_fast -DPGDEBUG=OFF
	cmake --build $(BUILD)/ne2k-release --parallel

# Keep a generated-code record of the real optimized polling paths; unlike
# the C host fixtures, this inspects ARM object disassembly and pioasm opcodes.
.PHONY: ultrags-path-report
ultrags-path-report: firmware
	$(UG_PYTHON) $(ROOT)/tools/ultrags/compare-firmware-paths.py \
		--build $(BUILD)/multifw-release --out $(BUILD)/host/firmware-paths

diagnostic: diagnostic-release diagnostic-debug

diagnostic-release: prepare-tools
	$(checkenv)
	@mkdir -p $(BUILD)/ultrags-diag-release
	cmake -S $(SW) -B $(BUILD)/ultrags-diag-release $(CMAKE_COMMON) \
		-DPROJECT_TYPE=ULTRAGS_DIAG -DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_DIAG_NO_DACK=OFF
	cmake --build $(BUILD)/ultrags-diag-release --parallel

diagnostic-debug: prepare-tools
	$(checkenv)
	@mkdir -p $(BUILD)/ultrags-diag-debug
	cmake -S $(SW) -B $(BUILD)/ultrags-diag-debug $(CMAKE_COMMON) \
		-DPROJECT_TYPE=ULTRAGS_DIAG -DPICO_BOARD=picogus2 -DPGDEBUG=ON -DUG_DIAG_NO_DACK=OFF
	cmake --build $(BUILD)/ultrags-diag-debug --parallel

host-test:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/run_host_tests.py --build $(BUILD)/host --cc "$(CC)"

budgets: diagnostic-release firmware
	@mkdir -p $(BUILD)/host
	$(UG_PYTHON) $(ROOT)/tools/ultrags/budget_report.py \
		--build-dir $(BUILD)/ultrags-diag-release \
		--multifw-dir $(BUILD)/multifw-release \
		--ne2k-dir $(BUILD)/ne2k-release \
		--sw $(SW) --tools $(ROOT)/tools/ultrags \
		--armgcc arm-none-eabi \
		--out $(BUILD)/host/budgets.json

# --- S0b targets: fixtures, DSS EXEs, stage package, gate suite -----------
UGBUILD := $(BUILD)/ultrags
NODE ?= node

# Programmer guide. Does not rebuild firmware or overwrite CURRENT.*.
UG_DOC_PYTHON ?= $(ROOT)/build/host/docs/venv/bin/python
.PHONY: docs docs-check docs-examples
docs-examples: $(UGBUILD)/gen/ug_wire.inc
	$(UG_PYTHON) $(ROOT)/tools/ultrags/docs-examples.py --build $(BUILD)

docs: dss docs-examples
	@mkdir -p $(ROOT)/build/host/docs
	$(UG_PYTHON) $(ROOT)/tools/ultrags/docs-sync.py --check
	$(UG_DOC_PYTHON) $(ROOT)/tools/ultrags/docs-pdf.py
	$(NODE) $(ROOT)/tools/ultrags/docs-package.mjs
	cp $(ROOT)/build/ULTRAGS-PROGRAMMING.pdf $(ROOT)/host/sprinter/ultrags/docs/ULTRAGS-PROGRAMMING.pdf

docs-check: docs s2-host
	$(UG_PYTHON) $(ROOT)/tools/ultrags/build-native-card.py --build $(ROOT)/build/native
	$(NODE) $(ROOT)/tools/ultrags/docs-examples-check.mjs
	$(NODE) $(ROOT)/tools/ultrags/nodss-check.mjs
	$(UG_PYTHON) $(ROOT)/tools/ultrags/docs-protocol-check.py
	$(UG_DOC_PYTHON) $(ROOT)/tools/ultrags/docs-check.py
	@mkdir -p $(ROOT)/build/host/docs/pages
	pdftoppm -scale-to 1100 -png $(ROOT)/build/ULTRAGS-PROGRAMMING.pdf $(ROOT)/build/host/docs/pages/page

$(UGBUILD)/gen/ug_wire.inc: $(ROOT)/tools/ultrags/wire-schema.json $(ROOT)/tools/ultrags/gen-wire.mjs
	@mkdir -p $(UGBUILD)/gen
	$(NODE) $(ROOT)/tools/ultrags/gen-wire.mjs $(ROOT)/tools/ultrags/wire-schema.json $(UGBUILD)/gen

fixtures:
	$(NODE) $(ROOT)/tools/ultrags/gen-fixtures.mjs --out $(UGBUILD)/fixtures

dss: $(UGBUILD)/gen/ug_wire.inc
	$(UG_PYTHON) $(ROOT)/tools/ultrags/gen-diag.py $(ROOT)/tools/ultrags/diag-schema.json $(UGBUILD)/gen
	$(NODE) $(ROOT)/tests/ultrags/dss/assemble.mjs $(ROOT) $(UGBUILD)/dss

# test-dss executes the EXACT bytes the dss target built (byte-identity
# chain: packaged EXE == executed EXE is verified by verify-package.mjs)
test-dss: dss s2-host s3-host s4-host s5-host s6-host
	UG_S2_CATALOG="$(abspath $(BUILD))/host/s2-catalog.bin" $(NODE) $(ROOT)/tests/ultrags/dss/run-ugdiag.mjs $(ROOT) $(UGBUILD) --exe-dir=$(UGBUILD)/dss

# honest S0b stage package: store-only ZIP + 1.44MiB FAT12 image,
# independently re-extracted and byte-verified.  NOT the production
# 13.2 bundle (no UGCFG/apps/seven-mode firmware - later stages).
package: test-dss fixtures
	$(NODE) $(ROOT)/tools/ultrags/package-s0b.mjs --exe-dir $(UGBUILD)/dss \
		--fixtures $(UGBUILD)/fixtures --out $(UGBUILD)/package
	$(NODE) $(ROOT)/tools/ultrags/verify-package.mjs --package $(UGBUILD)/package \
		--exe-dir $(UGBUILD)/dss --fixtures $(UGBUILD)/fixtures

# S0b stage gate: S0a host tests + schema/vector/protocol suite +
# fixtures determinism + stage-excerpt selftests + fresh DSS assembly +
# actual-EXE harness + package identity/tamper checks.
# Scope: HOST + DSS-EXE levels only; MAME/REAL hardware gates and the
# production 13.2 package remain PENDING per TZ 16.
check: test-dss
	$(UG_PYTHON) $(ROOT)/tools/ultrags/run_host_tests.py --build $(BUILD)/host --cc "$(CC)"
	$(NODE) $(ROOT)/tests/ultrags/protocol/run-protocol-tests.mjs $(ROOT) $(UGBUILD)
	$(NODE) $(ROOT)/tools/ultrags/gen-fixtures.mjs --out $(UGBUILD)/fixtures
	$(NODE) $(ROOT)/tools/ultrags/gen-fixtures.mjs --out $(UGBUILD)/fixtures-check
	$(NODE) $(ROOT)/tools/ultrags/test-fixtures.mjs $(UGBUILD)/fixtures $(UGBUILD)/fixtures-check
	$(NODE) $(ROOT)/tools/ultrags/test-stage-excerpt.mjs --out $(UGBUILD)/excerpts
	$(NODE) $(ROOT)/tools/ultrags/stage-excerpt.mjs --stage S0b --output $(UGBUILD)/excerpts/ultrags-S0b.md
	$(NODE) $(ROOT)/tools/ultrags/package-s0b.mjs --exe-dir $(UGBUILD)/dss \
		--fixtures $(UGBUILD)/fixtures --out $(UGBUILD)/package
	$(NODE) $(ROOT)/tools/ultrags/verify-package.mjs --package $(UGBUILD)/package \
		--exe-dir $(UGBUILD)/dss --fixtures $(UGBUILD)/fixtures
	$(NODE) $(ROOT)/tools/ultrags/test-package.mjs --package $(UGBUILD)/package \
		--exe-dir $(UGBUILD)/dss --fixtures $(UGBUILD)/fixtures
	@echo "S0b STAGE CHECK: HOST + DSS-EXE levels only;"
	@echo "  MAME/REAL hardware gates S1-S11 and production 13.2 package remain PENDING"

clean:
	@test "$(BUILD)" != "$(ROOT)" && test -n "$(BUILD)" && test "$(BUILD)" != "/"
	rm -rf $(BUILD)/multifw-release $(BUILD)/ne2k-release \
		$(BUILD)/ultrags-diag-release $(BUILD)/ultrags-diag-debug \
		$(BUILD)/host

# S1 stage gates: regression + real front-end/guard + standalone actual EXEs.
.PHONY: s1-check s1-package diagnostic-no-dack

diagnostic-no-dack: prepare-tools
	$(checkenv)
	cmake -S $(SW) -B $(BUILD)/ultrags-diag-no-dack $(CMAKE_COMMON) \
		-DPROJECT_TYPE=ULTRAGS_DIAG -DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_DIAG_NO_DACK=ON
	cmake --build $(BUILD)/ultrags-diag-no-dack --parallel

s1-check: check diagnostic diagnostic-no-dack budgets
	$(NODE) $(ROOT)/tools/ultrags/stage-excerpt.mjs --stage S1 --output $(UGBUILD)/excerpts/ultrags-S1.md
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s1-firmware-report.py --build $(BUILD)
	@echo "S1 HOST_PASS / DSS-EXE_PASS / REAL_PENDING (C00 not accepted)"

s1-package: s1-check
	$(NODE) $(ROOT)/tools/ultrags/package-s1.mjs --build $(BUILD)

.PHONY: s2-host s2-check s2-package ultrags
s2-host:
	@mkdir -p $(BUILD)/host
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s2-host.py --build $(BUILD)/host --cc "$(CC)"
	$(UG_PYTHON) $(ROOT)/tests/ultrags/unit/test_s2_pack.py $(BUILD)/host/s2-pack


ultrags: prepare-tools
	cmake -S $(SW) -B $(BUILD)/ultrags-release $(CMAKE_COMMON) \
		-DPROJECT_TYPE=ULTRAGS -DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_PSRAM_SCK_MHZ=100
	cmake --build $(BUILD)/ultrags-release --parallel

s2-check: s1-check ultrags s2-entrypoint
	UG_S2_CATALOG="$(abspath $(BUILD))/multifw-release/generated/multifw/catalog.bin" $(NODE) $(ROOT)/tests/ultrags/dss/run-s2.mjs $(ROOT) $(BUILD)
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s2-report.py --build $(BUILD)
	@echo "S2 HOST_PASS / DSS-EXE_PASS / REAL_PENDING"

s2-package: s2-check
	$(NODE) $(ROOT)/tools/ultrags/package-s2.mjs --build $(BUILD)

.PHONY: s2-entrypoint
s2-entrypoint: prepare-tools
	cmake -S $(SW)/multifw -B $(BUILD)/s2-entrypoint $(CMAKE_COMMON) \
		-DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_PSRAM_SCK_MHZ=100
	cmake --build $(BUILD)/s2-entrypoint --parallel

# S3: real storage C, UGMEM actual-EXE, all earlier gates and both clocks.
.PHONY: s3-host s3-check s3-package ultrags-slow ultrags-debug
s3-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s3-host.py --build $(BUILD)/host --cc "$(CC)"

ultrags-slow: prepare-tools
	cmake -S $(SW) -B $(BUILD)/ultrags-slow $(CMAKE_COMMON) \
		-DPROJECT_TYPE=ULTRAGS -DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_PSRAM_SCK_MHZ=50
	cmake --build $(BUILD)/ultrags-slow --parallel

ultrags-debug: prepare-tools
	cmake -S $(SW) -B $(BUILD)/ultrags-debug $(CMAKE_COMMON) \
		-DPROJECT_TYPE=ULTRAGS -DPICO_BOARD=picogus2 -DPGDEBUG=ON -DUG_PSRAM_SCK_MHZ=100
	cmake --build $(BUILD)/ultrags-debug --parallel

s3-check: s2-check s3-host ultrags-slow ultrags-debug
	$(NODE) $(ROOT)/tools/ultrags/stage-excerpt.mjs --stage S3 --output $(UGBUILD)/excerpts/ultrags-S3.md
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s3-report.py --build $(BUILD)
	@echo "S3 HOST_PASS / DSS-EXE_PASS / REAL_PENDING"

s3-package: s3-check
	$(NODE) $(ROOT)/tools/ultrags/package-s3.mjs --build $(BUILD)

# S4: real C storage/transfer/SEAL and actual assembled BLOB applications.
.PHONY: s4-host s4-check s4-package s4-full
s4-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s4-host.py --build $(BUILD)/host --cc "$(CC)"
s4-full: dss s4-host
	UG_S4_FULL=1 $(NODE) $(ROOT)/tests/ultrags/dss/run-s4.mjs $(ROOT) $(BUILD)
s4-check: export UG_S4_GATE=1
s4-check: s3-check s4-host s4-full
	$(NODE) $(ROOT)/tools/ultrags/stage-excerpt.mjs --stage S4 --output $(UGBUILD)/excerpts/ultrags-S4.md
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s4-report.py --build $(BUILD)
	@echo "S4 HOST_PASS / DSS-EXE_PASS / REAL_PENDING; C00 remains mandatory"
s4-package: s4-check
	$(NODE) $(ROOT)/tools/ultrags/package-s4.mjs --build $(BUILD)

# S5: BULK/aliases, bounded posted front-end and real BLOB benchmark.
.PHONY: s5-host s5-pio s5-posted s5-full s5-variants s5-check s5-package s6-host s6-check s6-package
s5-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s5-host.py --build $(BUILD)/host --cc "$(CC)"
s5-posted: prepare-tools
	cmake -S $(SW) -B $(BUILD)/ultrags-posted $(CMAKE_COMMON) -DPROJECT_TYPE=ULTRAGS -DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_ISA_WRITE_PROFILE=POSTED
	cmake --build $(BUILD)/ultrags-posted --parallel
	cmake -S $(SW) -B $(BUILD)/multifw-posted $(CMAKE_COMMON) -DPROJECT_TYPE=MULTIFW -DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_ISA_WRITE_PROFILE=POSTED
	cmake --build $(BUILD)/multifw-posted --parallel
	cmake -S $(SW)/multifw -B $(BUILD)/entrypoint-posted $(CMAKE_COMMON) -DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_ISA_WRITE_PROFILE=POSTED
	cmake --build $(BUILD)/entrypoint-posted --parallel
	cmake -S $(SW) -B $(BUILD)/diag-posted $(CMAKE_COMMON) -DPROJECT_TYPE=ULTRAGS_DIAG -DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_DIAG_NO_DACK=OFF -DUG_ISA_WRITE_PROFILE=POSTED
	cmake --build $(BUILD)/diag-posted --parallel
	cmake -S $(SW) -B $(BUILD)/diag-posted-no-dack $(CMAKE_COMMON) -DPROJECT_TYPE=ULTRAGS_DIAG -DPICO_BOARD=picogus2 -DPGDEBUG=OFF -DUG_DIAG_NO_DACK=ON -DUG_ISA_WRITE_PROFILE=POSTED
	cmake --build $(BUILD)/diag-posted-no-dack --parallel
s5-pio: s5-posted
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s5-pio.py --header $(BUILD)/ultrags-posted/ug_posted_iow.pio.h --out $(BUILD)/host/s5-pio.json
s5-full: dss s5-host
	UG_S5_FULL=1 $(NODE) $(ROOT)/tests/ultrags/dss/run-s5.mjs $(ROOT) $(BUILD)
s5-variants: dss s2-host
	$(NODE) $(ROOT)/tools/ultrags/s5-variants.mjs $(BUILD)
s5-check: export UG_S5_GATE=1
s5-check: s4-check s5-host s5-pio s5-full s5-variants
	$(NODE) $(ROOT)/tools/ultrags/stage-excerpt.mjs --stage S5 --output $(UGBUILD)/excerpts/ultrags-S5.md
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s5-report.py --build $(BUILD)
	@echo "S5 HOST_PASS / DSS-EXE_PASS / REAL_PENDING; HANDSHAKE release default"
s5-package: s5-check
	$(NODE) $(ROOT)/tools/ultrags/package-s5.mjs --build $(BUILD)

# S6: RAW/WAV, resident handles, dedicated FX and actual assembled applications.
# Full S0a-S5 regressions, indexed audio goldens and independent C/model vectors.
# Physical audio/ISA acceptance remains REAL_PENDING after the software gate.
s6-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s6-host.py --build $(BUILD)/host/s6 --cc "$(CC)"

s6-check: s5-check s6-host ultrags fixtures
	$(NODE) $(ROOT)/tools/ultrags/stage-excerpt.mjs --stage S6 --output $(UGBUILD)/excerpts/ultrags-S6.md
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s6-report.py --build $(BUILD)
	@echo "S6 HOST_PASS / DSS-EXE_PASS / REAL_PENDING; physical audio/timing gate remains open"

s6-package: s6-check
	$(NODE) $(ROOT)/tools/ultrags/package-s6.mjs --build $(BUILD)
	$(UG_PYTHON) $(ROOT)/tests/ultrags/unit/test_s6_package.py --build $(BUILD)

.PHONY: s7-host s7-stack s7-native-check s7-native-package s7-check
s7-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s7-host.py --build $(BUILD)/host/s7 --cc "$(CC)"

s7-stack: ultrags
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s7-stack.py --build $(BUILD)

s7-native-check: dss s2-host s6-host s7-host
	UG_S2_CATALOG="$(abspath $(BUILD))/host/s2-catalog.bin" \
		$(NODE) $(ROOT)/tests/ultrags/dss/run-s7.mjs $(ROOT) $(BUILD)
	$(NODE) $(ROOT)/tools/ultrags/s7-report.mjs --build $(BUILD)
	$(UG_PYTHON) $(ROOT)/tests/ultrags/unit/test_s7_evidence.py --build $(BUILD)
	@echo "S7 IN_PROGRESS: native regression subset passed; GS105 is a separate software gate; REAL remains open"

s7-native-package: test-dss s7-native-check fixtures s7-stack firmware
	$(NODE) $(ROOT)/tools/ultrags/package-s0b.mjs --stage S7 --exe-dir $(UGBUILD)/dss \
		--fixtures $(UGBUILD)/fixtures --out $(UGBUILD)/s7-native-package
	$(NODE) $(ROOT)/tools/ultrags/verify-package.mjs --stage S7 --package $(UGBUILD)/s7-native-package \
		--exe-dir $(UGBUILD)/dss --fixtures $(UGBUILD)/fixtures
	$(NODE) $(ROOT)/tools/ultrags/test-package.mjs --stage S7 --package $(UGBUILD)/s7-native-package \
		--exe-dir $(UGBUILD)/dss --fixtures $(UGBUILD)/fixtures

# A successful subset must not masquerade as the complete S7 acceptance gate.
s7-check: s6-check s7-native-check s7-stack gs105-check
	@echo "S7 software HOST_PASS / DSS_EXE_PASS; S7 IN_PROGRESS / REAL_PENDING"

# DSS ISA clock correction only; firmware acceptance remains separate.
.PHONY: isa-dss-check
isa-dss-check: test-dss fixtures
	$(NODE) $(ROOT)/tests/ultrags/dss/turbo-contract.mjs $(ROOT) $(BUILD)
	$(NODE) $(ROOT)/tools/ultrags/s5-variants.mjs $(BUILD)
	UG_S4_FULL=1 $(NODE) $(ROOT)/tests/ultrags/dss/run-s4.mjs $(ROOT) $(BUILD)
	UG_S5_FULL=1 $(NODE) $(ROOT)/tests/ultrags/dss/run-s5.mjs $(ROOT) $(BUILD)
	$(NODE) $(ROOT)/tools/ultrags/package-s0b.mjs --stage ISA --exe-dir $(UGBUILD)/dss \
		--fixtures $(UGBUILD)/fixtures --out $(UGBUILD)/package
	$(NODE) $(ROOT)/tools/ultrags/verify-package.mjs --stage ISA --exe-dir $(UGBUILD)/dss \
		--fixtures $(UGBUILD)/fixtures --package $(UGBUILD)/package
	$(NODE) $(ROOT)/tools/ultrags/test-package.mjs --stage ISA --exe-dir $(UGBUILD)/dss \
		--fixtures $(UGBUILD)/fixtures --package $(UGBUILD)/package

# Configuration correction: same bytes in actual-EXE harness and DSS packages.
.PHONY: cfg-check cfg-package
cfg-check: ultrags-path-report test-dss fixtures
	$(UG_PYTHON) $(ROOT)/tools/ultrags/pio-isa-check.py --build $(BUILD)/multifw-release --out $(BUILD)/host/pio-isa.json
	$(UG_PYTHON) $(ROOT)/tools/ultrags/psram-id-check.py --build $(BUILD)/multifw-release --out $(BUILD)/host/psram-id.json
	$(UG_PYTHON) $(ROOT)/tools/ultrags/handshake-guard-check.py --build $(BUILD)/multifw-release --out $(BUILD)/host/guard
	$(UG_PYTHON) $(ROOT)/tools/ultrags/save-clock-check.py --build $(BUILD) --cc "$(CC)"
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/audio-render-check.py --build $(BUILD) $(if $(UG_AUDIO_BASELINE),--baseline "$(UG_AUDIO_BASELINE)")
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/config-read-arm.py --build $(BUILD) $(if $(UG_CONFIG_BASELINE),--baseline "$(UG_CONFIG_BASELINE)")
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/config-read-deadline.py --build $(BUILD) $(if $(UG_CONFIG_WAIT_BASELINE),--baseline "$(UG_CONFIG_WAIT_BASELINE)")
	$(NODE) $(ROOT)/tests/ultrags/dss/ug-card-test.mjs
	$(UG_PYTHON) $(ROOT)/tests/ultrags/unit/test_cfg_bundle.py --build $(BUILD)
	$(UG_PYTHON) $(ROOT)/tools/ultrags/config-exchange.py --build $(BUILD)/host --catalog $(BUILD)/multifw-release/generated/multifw/catalog.bin
	$(UG_PYTHON) $(ROOT)/tools/ultrags/config-write-window.py --build $(BUILD)/multifw-release --fixture $(BUILD)/host --out $(BUILD)/host/write-window
	UG_S2_CATALOG="$(abspath $(BUILD))/multifw-release/generated/multifw/catalog.bin" $(NODE) $(ROOT)/tests/ultrags/dss/run-s2.mjs $(ROOT) $(BUILD)
	$(NODE) $(ROOT)/tests/ultrags/dss/config-regression.mjs $(ROOT) $(BUILD)
	$(NODE) $(ROOT)/tests/ultrags/dss/turbo-contract.mjs $(ROOT) $(BUILD)

cfg-package: cfg-check
	$(NODE) $(ROOT)/tools/ultrags/package-s0b.mjs --stage CFG --exe-dir $(UGBUILD)/dss --fixtures $(UGBUILD)/fixtures --out $(UGBUILD)/cfg-package
	$(NODE) $(ROOT)/tools/ultrags/verify-package.mjs --stage CFG --exe-dir $(UGBUILD)/dss --fixtures $(UGBUILD)/fixtures --package $(UGBUILD)/cfg-package
	$(NODE) $(ROOT)/tools/ultrags/test-package.mjs --stage CFG --exe-dir $(UGBUILD)/dss --fixtures $(UGBUILD)/fixtures --package $(UGBUILD)/cfg-package
	$(UG_PYTHON) $(ROOT)/tools/ultrags/package-cfg.py --build $(BUILD) $(if $(CFG_COMPARE_EXE_DIR),--compare-exe-dir "$(CFG_COMPARE_EXE_DIR)")

# Separate host-only experiments; never replaces the default cap8/off profile.
# Build the independent directory first, then pass FAST_COMPARE_BUILD to
# require byte-identical executed EXEs and ZIP/IMG in both directories.
.PHONY: throughput-package
throughput-package: cfg-package
	$(NODE) $(ROOT)/tools/ultrags/package-throughput.mjs $(BUILD) $(FAST_COMPARE_BUILD)

# Initial API 1.0 VLS1. Private unchanged guest inputs are read, never packaged.
# Set UG_PROPLAY and UG_PROPLAY_MOD, then run this independently for A and B.
.PHONY: voices-host voices-firmware voices-package
voices-host: test-dss fixtures
	$(UG_PYTHON) $(ROOT)/tools/ultrags/voices-host.py --build $(BUILD)

voices-firmware:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/voices-firmware.py --build $(BUILD)

VOICES_COMPARE_BUILD ?= $(BUILD)/reproducibility
VOICES_DELIVERY ?= $(BUILD)/voices-package
voices-package:
	$(NODE) $(ROOT)/tools/ultrags/package-voices.mjs $(BUILD) $(VOICES_COMPARE_BUILD) $(VOICES_DELIVERY)

# Streaming PCM: production C, exact Z80 bytes and optional Turbo-write profile.
.PHONY: s8c-host s8c-check s8c-exe s8c-performance s8c-package s8c-arm
s8c-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s8c-host.py --build $(BUILD)/host/s8c

s8c-exe: dss s2-host s8c-host
	$(UG_PYTHON) $(ROOT)/tools/ultrags/build-native-card.py --build $(BUILD)/native
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s8c-fast.py --build $(BUILD)
	UG_STREAM_LONG=1 $(NODE) $(ROOT)/tests/ultrags/dss/run-stream.mjs $(ROOT) $(BUILD)
	UG_STREAM_EXE=UGPF.EXE $(NODE) $(ROOT)/tests/ultrags/dss/run-stream.mjs $(ROOT) $(BUILD)

s8c-performance: s8c-exe
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s8c-performance.py --build $(BUILD)

# Includes R17, MOD4/8/FLT4/FLT8/MOD1..32/F00, exact ARM PCM and production C.
s8c-check: s8b-check s8c-performance
	@echo "S8c HOST_PASS / REAL_PENDING; prior hardware failures remain open"

# Both fixed roots must first pass s8c-check (second: REPRODUCIBILITY=1).
s8c-package:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/compat-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/catalog-fast-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/gs-fast-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(NODE) $(ROOT)/tools/ultrags/test-s8b-evidence.mjs $(ROOT)/build
	$(NODE) $(ROOT)/tools/ultrags/test-s8b-evidence.mjs $(ROOT)/build/reproducibility
	$(NODE) $(ROOT)/tools/ultrags/test-s8c-evidence.mjs $(ROOT)/build
	$(NODE) $(ROOT)/tools/ultrags/test-s8c-evidence.mjs $(ROOT)/build/reproducibility
	$(NODE) $(ROOT)/tools/ultrags/package-gs105.mjs --s8c
	$(NODE) $(ROOT)/tools/ultrags/package-gs105.mjs --s8c --verify-only

s8c-arm:
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/s8c-arm.py --build $(BUILD)

# S8a native MOD8 and concurrent storage; physical acceptance remains separate.
.PHONY: s8a-host s8a-fixtures s8a-exe s8a-package
s8a-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s8a-host.py --build $(BUILD)/host/s8a
s8a-fixtures:
	$(NODE) $(ROOT)/tools/ultrags/gen-s8a.mjs $(BUILD)/s8a-test-audio
s8a-exe: dss s8a-fixtures
	$(UG_PYTHON) $(ROOT)/tools/ultrags/build-native-card.py --build $(BUILD)/native
	$(NODE) $(ROOT)/tests/ultrags/dss/run-s8a.mjs $(ROOT) $(BUILD)
s8a-package:
	$(NODE) $(ROOT)/tools/ultrags/package-s8a.mjs

# Explicit MOD F00 policy: immutable originals are private inputs, not payload.
.PHONY: f00-host f00-bruno f00-exe
f00-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/f00-host.py --build $(BUILD)/host/f00
f00-bruno: f00-host
	@test -n "$(UG_F00_MOD)" || { echo "Set UG_F00_MOD to the original bruno_-_bst.mod"; exit 2; }
	$(UG_PYTHON) $(ROOT)/tools/ultrags/f00-bruno.py --build $(BUILD)/host/f00 --mod "$(UG_F00_MOD)"
f00-exe: dss f00-bruno
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s8c-fast.py --build $(BUILD)
	$(UG_PYTHON) $(ROOT)/tools/ultrags/build-native-card.py --build $(BUILD)/native
	UG_F00_MOD="$(UG_F00_MOD)" $(NODE) $(ROOT)/tests/ultrags/dss/run-f00.mjs $(ROOT) $(BUILD)

# GS105 compatibility is checked at Turbo OFF. The GS Turbo ON fix and FLT8
# are separate following stages. Private originals are read, never packaged.
.PHONY: gs105-host gs105-exe gs105-check gs105-package
gs105-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/gs105-host.py --build $(BUILD)/host/gs105
gs105-exe: dss s2-host
	$(UG_PYTHON) $(ROOT)/tools/ultrags/build-native-card.py --build $(BUILD)/native
	UG_PROPLAY_MOD="$(UG_PROPLAY_MOD)" UG_F00_MOD="$(UG_F00_MOD)" $(NODE) $(ROOT)/tests/ultrags/dss/run-gs.mjs $(ROOT) $(BUILD)
gs105-check: gs105-host gs105-exe s7-host s8a-host f00-host
	@test -n "$(UG_PROPLAY)" || { echo "Set UG_PROPLAY to unchanged PROPLAY.EXE"; exit 2; }
	UG_PROPLAY="$(UG_PROPLAY)" UG_PROPLAY_MOD="$(UG_PROPLAY_MOD)" $(NODE) $(ROOT)/tests/ultrags/dss/run-native.mjs $(ROOT) $(BUILD)
	$(UG_PYTHON) $(ROOT)/tools/ultrags/f00-bruno.py --build $(BUILD)/host/f00 --mod "$(UG_F00_MOD)"
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s8c-fast.py --build $(BUILD)
	UG_F00_MOD="$(UG_F00_MOD)" $(NODE) $(ROOT)/tests/ultrags/dss/run-f00.mjs $(ROOT) $(BUILD)
	$(NODE) $(ROOT)/tests/ultrags/dss/run-s8a.mjs $(ROOT) $(BUILD)
	UG_S2_CATALOG="$(BUILD)/host/s2-catalog.bin" $(NODE) $(ROOT)/tests/ultrags/dss/run-s7.mjs $(ROOT) $(BUILD)
	$(NODE) $(ROOT)/tests/ultrags/dss/run-lowram.mjs $(ROOT) $(BUILD)
	$(UG_PYTHON) $(ROOT)/tools/ultrags/gs105-report.py --build $(BUILD)
	$(UG_PYTHON) $(ROOT)/tests/ultrags/unit/test_gs105_evidence.py --build $(BUILD)
gs105-package:
	$(NODE) $(ROOT)/tools/ultrags/package-gs105.mjs

# Pre-fix negative control only: success reproduces the known missing early
# GS hold. This target does not accept Turbo ON or publish a firmware bundle.
.PHONY: gs-turbo-control
gs-turbo-control:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/gs-turbo-control.py --build $(ROOT)/build --frozen

# REPRODUCIBILITY=1 uses only the fixed build/reproducibility directory.
# R17 keeps the COMPAT profile (IOW10/IOR22 + direct CONFIG/GS handlers);
# the GS alias block is classified in PIO, so the COMPAT gates apply.
.PHONY: gs-turbo-check gs-turbo-package
gs-turbo-check: test-dss gs105-check s8c-host s8a-fixtures
	$(UG_PYTHON) $(ROOT)/tools/ultrags/compat-check.py --build $(BUILD)/multifw-release --out $(BUILD)/host/gs-turbo/compat
	$(NODE) $(ROOT)/tools/ultrags/compat-independent.cjs $(BUILD)/multifw-release/ug_compat_ior.pio.h $(BUILD)/host/gs-turbo/independent-pio.json
	$(UG_PYTHON) $(ROOT)/tools/ultrags/config-exchange.py --build $(BUILD)/host/gs-turbo/config --catalog $(BUILD)/multifw-release/generated/multifw/catalog.bin --compat --fast --gs-fast
	$(NODE) $(ROOT)/tests/ultrags/dss/run-gs-turbo.mjs $(ROOT) $(BUILD)
	$(NODE) $(ROOT)/tests/ultrags/dss/run-stream.mjs $(ROOT) $(BUILD)
	UG_STREAM_EXE=UGPF.EXE $(NODE) $(ROOT)/tests/ultrags/dss/run-stream.mjs $(ROOT) $(BUILD)
gs-turbo-package:
	$(NODE) $(ROOT)/tools/ultrags/package-gs105.mjs --gs-turbo

# S8b FLT8, FLT4 and MOD1..32; UG_MULTIMOD optionally tests an original file.
.PHONY: s8b-host s8b-fixtures s8b-exe s8b-arm s8b-check s8b-package
s8b-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s8b-host.py --build $(BUILD)/host/s8b $(if $(UG_MULTIMOD),--mod "$(UG_MULTIMOD)") $(if $(UG_FLT8_MOD),--flt8-mod "$(UG_FLT8_MOD)")
	$(if $(UG_MULTIMOD),$(UG_PYTHON) $(ROOT)/tools/ultrags/multimod-reference.py --build $(BUILD)/host/s8b --mod "$(UG_MULTIMOD)",@true)
	$(if $(UG_FLT8_MOD),$(UG_PYTHON) $(ROOT)/tools/ultrags/multimod-reference.py --flt8 --build $(BUILD)/host/s8b --mod "$(UG_FLT8_MOD)",@true)
s8b-fixtures:
	$(NODE) $(ROOT)/tools/ultrags/gen-s8b.mjs $(BUILD)/host/s8b/fixtures
s8b-exe: dss s8b-fixtures
	$(UG_PYTHON) $(ROOT)/tools/ultrags/build-native-card.py --build $(BUILD)/native
	UG_MULTIMOD="$(UG_MULTIMOD)" UG_FLT8_MOD="$(UG_FLT8_MOD)" $(NODE) $(ROOT)/tests/ultrags/dss/run-s8b.mjs $(ROOT) $(BUILD)
# Pin the accepted R17 frontend even when the fixed CMake tree is empty.
s8b-arm: CMAKE_COMMON += -DUG_ISA_FRONTEND=COMPAT -DUG_CONFIG_CATALOG_FAST=ON -DUG_GS_STATUS_FAST=ON -DUG_LED_DIAG=OFF -DUG_CONFIG_PROBE=OFF -DUG_CONFIG_TRACE=OFF
s8b-arm: s8b-host s8b-fixtures firmware
	UG_MULTIMOD="$(UG_MULTIMOD)" UG_FLT8_MOD="$(UG_FLT8_MOD)" $(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/s8b-arm.py --build $(BUILD)
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/s8c-arm.py --build $(BUILD)
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/audio-render-check.py --build $(BUILD)
s8b-check: s8b-arm gs-turbo-check s8b-host s8b-exe
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s7-stack.py --build $(BUILD)
	@echo "S8b HOST_PASS / REAL_PENDING; Sprinter audio/return must be confirmed"
s8b-package:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/compat-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/catalog-fast-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/gs-fast-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(NODE) $(ROOT)/tools/ultrags/package-gs105.mjs --s8b

# Fixed-port OPL2 alongside MOD8 + four mono / two stereo FX. Both roots must
# pass this target before adlib-package. S8c hardware REAL_FAIL stays open.
UG_ADLIB_BASELINE ?= $(ROOT)/build/archive/pre-adlib/CURRENT.UF2
.PHONY: adlib-host adlib-exe adlib-arm adlib-check adlib-package
adlib-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/adlib-host.py --build $(BUILD)/host/adlib
adlib-exe: dss s2-host f00-host
	$(UG_PYTHON) $(ROOT)/tools/ultrags/build-native-card.py --build $(BUILD)/native --adlib
	$(NODE) $(ROOT)/tests/ultrags/dss/run-adlib.mjs $(ROOT) $(BUILD)
adlib-arm: adlib-host firmware
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/adlib-arm.py --build $(BUILD)
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/adlib-read-linked.py --build $(BUILD)
adlib-check: export UG_STREAM_LONG=1
adlib-check: s8b-check adlib-exe adlib-arm
	$(UG_PYTHON) $(ROOT)/tools/ultrags/adlib-legacy.py --build $(BUILD)
	$(UG_PYTHON) $(ROOT)/tools/ultrags/voices-budgets.py --adlib --build $(BUILD) --baseline "$(UG_ADLIB_BASELINE)"
	$(NODE) $(ROOT)/tools/ultrags/test-adlib-evidence.mjs $(BUILD)
	@echo "AdLib HOST_PASS / REAL_PENDING; listening, physical timing and 30-minute MIX acceptance pending"
adlib-package:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/compat-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/adlib-read-linked.py --build $(ROOT)/build --build $(ROOT)/build/reproducibility
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/catalog-fast-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/gs-fast-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(NODE) $(ROOT)/tools/ultrags/test-adlib-evidence.mjs $(ROOT)/build
	$(NODE) $(ROOT)/tools/ultrags/test-adlib-evidence.mjs $(ROOT)/build/reproducibility
	$(NODE) $(ROOT)/tools/ultrags/package-gs105.mjs --adlib
	$(NODE) $(ROOT)/tools/ultrags/test-adlib-package.mjs
	$(NODE) $(ROOT)/tools/ultrags/package-gs105.mjs --adlib --verify-only

# WAV IMA ADPCM (format 0x11): ffmpeg fixtures/reference, production C under UBSan.
.PHONY: adpcm-host adpcm-exe adpcm-check
adpcm-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/adpcm-host.py --build $(BUILD)/host/adpcm --cc "$(CC)"
adpcm-exe: dss s2-host adpcm-host
	$(UG_PYTHON) $(ROOT)/tools/ultrags/build-native-card.py --build $(BUILD)/native
	$(NODE) $(ROOT)/tests/ultrags/dss/run-adpcm.mjs $(ROOT) $(BUILD)
adpcm-check: adpcm-exe
	@echo "WAV IMA ADPCM HOST_PASS / DSS-EXE_PASS / REAL_PENDING"

# S3M PCM/ST3 profile: independent reference, real EXEs and linked ARM.
UG_S3M_BASELINE ?= $(ROOT)/build/archive/pre-s3m/CURRENT.UF2
.PHONY: s3m-host s3m-exe s3m-arm s3m-budgets s3m-check s3m-package
s3m-host:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s3m-host.py --build $(BUILD)/host/s3m
s3m-exe: dss s2-host s3m-host docs-examples
	$(UG_PYTHON) $(ROOT)/tools/ultrags/build-native-card.py --build $(BUILD)/native
	$(NODE) $(ROOT)/tests/ultrags/dss/run-s3m.mjs $(ROOT) $(BUILD)
	$(NODE) $(ROOT)/tools/ultrags/docs-examples-check.mjs $(BUILD)
s3m-arm: CMAKE_COMMON += -DUG_ISA_FRONTEND=COMPAT -DUG_CONFIG_CATALOG_FAST=ON -DUG_GS_STATUS_FAST=ON -DUG_LED_DIAG=OFF -DUG_CONFIG_PROBE=OFF -DUG_CONFIG_TRACE=OFF
s3m-arm: firmware adlib-host
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/s3m-arm.py --build $(BUILD)
	$(UG_PYTHON) $(ROOT)/tools/ultrags/s7-stack.py --build $(BUILD)
s3m-budgets:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/voices-budgets.py --build $(BUILD) --baseline "$(UG_S3M_BASELINE)"
s3m-check: s3m-exe s3m-arm adlib-check
	$(MAKE) -f $(ROOT)/Makefile.ultrags s3m-budgets
	$(NODE) $(ROOT)/tools/ultrags/test-s3m-evidence.mjs $(BUILD)
# Both fixed roots must pass s3m-check, including the guide examples.
s3m-package:
	$(UG_PYTHON) $(ROOT)/tools/ultrags/compat-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/catalog-fast-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(UG_AUDIO_PYTHON) $(ROOT)/tools/ultrags/gs-fast-linked.py $(ROOT)/build $(ROOT)/build/reproducibility
	$(NODE) $(ROOT)/tools/ultrags/test-s3m-evidence.mjs $(ROOT)/build
	$(NODE) $(ROOT)/tools/ultrags/test-s3m-evidence.mjs $(ROOT)/build/reproducibility
	$(NODE) $(ROOT)/tools/ultrags/package-gs105.mjs --s3m
	$(NODE) $(ROOT)/tools/ultrags/package-gs105.mjs --s3m --verify-only
