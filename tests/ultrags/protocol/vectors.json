{
  "meta": {
    "name": "ultrags-wire-vectors",
    "note": "HANDWRITTEN independent expected vectors checked against ultra-gs.md v1.7. Never generated by gen-wire.mjs or any serializer. Hex strings are LE wire order unless noted.",
    "source": "ultra-gs.md sections 5, 6.1, 6.2, 6.3, 6.5, 7.2, 7.3, 7.8, 8.2, 12.6"
  },
  "crc32_iso_hdlc": [
    { "name": "crc_empty", "data": "", "crc": "0x00000000", "note": "spec: CRC of empty array = 0" },
    { "name": "crc_123456789", "data": "313233343536373839", "crc": "0xCBF43926", "note": "spec 6.1 canonical check" },
    { "name": "crc_00010203", "data": "00010203", "crc": "0x8BB98613", "note": "spec 12.6" },
    { "name": "crc_8000", "data": "8000", "crc": "0x7A5A8AB4", "note": "spec 12.6: CRC of header2 of INFO+FRAME_CRC request" },
    { "name": "crc_ff", "data": "FF", "crc": "0xFF000000", "note": "derived: CRC32/ISO-HDLC of single 0xFF" }
  ],
  "frames": [
    {
      "name": "info_fast",
      "note": "spec 12.6: INFO request, no CRC",
      "opcode": "0x00", "payload": "", "frame_crc": false,
      "expect_request": "00 00",
      "expect_resp_header": "00 24",
      "resp_payload_len": 36
    },
    {
      "name": "info_crc",
      "note": "spec 12.6: INFO request with FRAME_CRC",
      "opcode": "0x00", "payload": "", "frame_crc": true,
      "expect_request": "80 00 B4 8A 5A 7A"
    },
    {
      "name": "write_begin_fast_h1234",
      "note": "spec 12.6: WRITE_BEGIN h=1234h off=0 N=1024 transport=BULK_FAST",
      "opcode": "0x20", "payload": "34 12 00 00 00 00 00 04 00", "frame_crc": false,
      "expect_request": "20 09 34 12 00 00 00 00 00 04 00",
      "resp_ok": "00 04 01 00 00 00"
    },
    {
      "name": "write_end_fast_tok1",
      "note": "spec 12.6: WRITE_END token=1",
      "opcode": "0x21", "payload": "01 00 00 00", "frame_crc": false,
      "expect_request": "21 04 01 00 00 00",
      "resp_ok": "00 00"
    },
    {
      "name": "read_begin_fast",
      "opcode": "0x22", "payload": "34 12 00 00 00 00 00 04 00", "frame_crc": false,
      "expect_request": "22 09 34 12 00 00 00 00 00 04 00"
    },
    {
      "name": "read_end_fast",
      "opcode": "0x23", "payload": "01 00 00 00", "frame_crc": false,
      "expect_request": "23 04 01 00 00 00"
    },
    {
      "name": "write_begin_verified",
      "note": "VERIFIED adds crc:u32 at payload end: 13-byte payload, transport=80h",
      "opcode": "0x20", "payload": "34 12 00 00 00 00 00 04 80 78 56 34 12", "frame_crc": false,
      "expect_request": "20 0D 34 12 00 00 00 00 00 04 80 78 56 34 12"
    },
    {
      "name": "read_begin_verified",
      "note": "READ_BEGIN request NEVER has crc field even in VERIFIED (spec 6.3): 9-byte payload, transport=80h",
      "opcode": "0x22", "payload": "34 12 00 00 00 00 00 04 80", "frame_crc": false,
      "expect_request": "22 09 34 12 00 00 00 00 00 04 80"
    },
    {
      "name": "write_end_verified_tok1",
      "note": "WRITE_END request never has host_crc: VERIFIED write puts crc in BEGIN only; bytes identical to FAST",
      "opcode": "0x21", "payload": "01 00 00 00", "frame_crc": false,
      "expect_request": "21 04 01 00 00 00"
    },
    {
      "name": "read_end_verified_tok1",
      "note": "READ_END VERIFIED adds host_crc:u32 -> 8-byte payload; token=1, crc=8BB98613h",
      "opcode": "0x23", "payload": "01 00 00 00 13 86 B9 8B", "frame_crc": false,
      "expect_request": "23 08 01 00 00 00 13 86 B9 8B"
    },
    {
      "name": "stats_crc",
      "note": "len-0 payload + FRAME_CRC on opcode 03: crc32(83 00)=5177D977h -> LE 77 D9 77 51",
      "opcode": "0x03", "payload": "", "frame_crc": true,
      "expect_request": "83 00 77 D9 77 51"
    },
    {
      "name": "frame_128_crc",
      "note": "max payload 128 + FRAME_CRC = 134 bytes total. Serializer vector only; opcode 50h would reject non-zero payload card-side. Payload pattern 00..7F, crc32(D0 80 00..7F)=E126D16Ah -> LE 6A D1 26 E1",
      "opcode": "0x50", "payload_seq": "0..127", "frame_crc": true,
      "expect_request_prefix": "D0 80",
      "expect_request_trailer": "6A D1 26 E1",
      "expect_total_len": 134
    },
    {
      "name": "alloc_raw_4k",
      "opcode": "0x10", "payload": "01 00 10 00 00", "frame_crc": false,
      "expect_request": "10 05 01 00 10 00 00",
      "note": "kind=1 RAW_PCM, size=0x1000"
    },
    {
      "name": "seal_h1_noflags",
      "opcode": "0x13", "payload": "01 00 00 00 00 00 00", "frame_crc": false,
      "expect_request": "13 07 01 00 00 00 00 00 00"
    },
    {
      "name": "pcm_config_44100_s16le_stereo",
      "opcode": "0x14",
      "payload": "01 00 44 AC 00 00 02 10 02 00 00 00 00 00 00 80 00 00 00 00 00 00 00 00 00 00",
      "frame_crc": false,
      "expect_request": "14 1A 01 00 44 AC 00 00 02 10 02 00 00 00 00 00 00 80 00 00 00 00 00 00 00 00 00 00",
      "note": "handle=1, rate=44100, ch=2, bits=16, fmt=2(S16LE), len=0x8000"
    },
    {
      "name": "object_info_h1",
      "opcode": "0x12", "payload": "01 00", "frame_crc": false,
      "expect_request": "12 02 01 00"
    },
    {
      "name": "mem_info",
      "opcode": "0x02", "payload": "", "frame_crc": false,
      "expect_request": "02 00",
      "expect_resp_header": "00 14",
      "resp_payload_len": 20
    },
    {
      "name": "caps",
      "opcode": "0x01", "payload": "", "frame_crc": false,
      "expect_request": "01 00",
      "expect_resp_header": "00 20",
      "resp_payload_len": 32
    },
    {
      "name": "stats",
      "opcode": "0x03", "payload": "", "frame_crc": false,
      "expect_request": "03 00",
      "expect_resp_header": "00 40",
      "resp_payload_len": 64
    },
    {
      "name": "snapshot",
      "opcode": "0x50", "payload": "", "frame_crc": false,
      "expect_request": "50 00",
      "expect_resp_header": "00 80",
      "resp_payload_len": 128
    },
    {
      "name": "transfer_cancel",
      "opcode": "0x24", "payload": "EF BE AD DE", "frame_crc": false,
      "expect_request": "24 04 EF BE AD DE"
    },
    {
      "name": "max_payload_128",
      "opcode": "0x14", "payload_len_repeat": 128, "frame_crc": false,
      "expect_request_prefix": "14 80",
      "note": "payload_length=128 is the max legal; frame total = 130 bytes"
    },
    {
      "name": "queue_add",
      "opcode": "0x41", "payload": "34 12 03 00 40 20", "frame_crc": false,
      "expect_request": "41 06 34 12 03 00 40 20"
    },
    {
      "name": "write_begin_frame_crc",
      "note": "WRITE_BEGIN fast payload + FRAME_CRC trailer: crc32(A0 09 + 9B payload)=4FC042E2h -> LE E2 42 C0 4F (zlib.crc32 cross-checked)",
      "opcode": "0x20", "payload": "34 12 00 00 00 00 00 04 00", "frame_crc": true,
      "expect_request": "A0 09 34 12 00 00 00 00 00 04 00 E2 42 C0 4F"
    }
  ],
  "le_encoding": [
    { "name": "u16_0001", "type": "u16", "value": "0x0001", "expect": "01 00" },
    { "name": "u16_00FF", "type": "u16", "value": "0x00FF", "expect": "FF 00" },
    { "name": "u16_0100", "type": "u16", "value": "0x0100", "expect": "00 01" },
    { "name": "u16_7FFF", "type": "u16", "value": "0x7FFF", "expect": "FF 7F" },
    { "name": "u16_8000", "type": "u16", "value": "0x8000", "expect": "00 80" },
    { "name": "u16_FFFF", "type": "u16", "value": "0xFFFF", "expect": "FF FF" },
    { "name": "u32_0", "type": "u32", "value": "0x00000000", "expect": "00 00 00 00" },
    { "name": "u32_64K", "type": "u32", "value": "0x00010000", "expect": "00 00 01 00" },
    { "name": "u32_1MiB", "type": "u32", "value": "0x00100000", "expect": "00 00 10 00" },
    { "name": "u32_8MiB_m1", "type": "u32", "value": "0x007FFFFF", "expect": "FF FF 7F 00" },
    { "name": "u32_max", "type": "u32", "value": "0xFFFFFFFF", "expect": "FF FF FF FF" },
    { "name": "u64_session", "type": "u64", "value": "0x0102030405060708", "expect": "08 07 06 05 04 03 02 01" }
  ],
  "struct_offsets": [
    { "struct": "INFO", "field": "session", "off": 12, "size": 36 },
    { "struct": "INFO", "field": "build_id", "off": 20 },
    { "struct": "CAPS", "field": "base", "off": 24, "size": 32 },
    { "struct": "OBJECT_INFO", "field": "size", "off": 6, "size": 38 },
    { "struct": "OBJECT_INFO", "field": "mod_channels", "off": 37 },
    { "struct": "PCM_DESC", "field": "data_offset", "off": 8, "size": 24 },
    { "struct": "PCM_DESC", "field": "loop_end", "off": 20 },
    { "struct": "SNAPSHOT", "field": "session", "off": 4, "size": 128 },
    { "struct": "SNAPSHOT", "field": "state", "off": 24 },
    { "struct": "SNAPSHOT", "field": "chan", "off": 56 },
    { "struct": "SNAPSHOT", "field": "transfer_id", "off": 120 },
    { "struct": "SNAPSHOT", "field": "transfer_length", "off": 126 },
    { "struct": "GS_DESC", "field": "reply_ptr", "off": 7, "size": 9 },
    { "struct": "FXREC", "field": "source_frame", "off": 8, "size": 16 },
    { "struct": "FXREC", "field": "flags", "off": 15 },
    { "struct": "CHANREC", "field": "period", "off": 4, "size": 8 },
    { "struct": "FW_CATALOG", "field": "records", "off": 16, "size": 148 },
    { "struct": "FW_CATALOG", "field": "catalog_crc32", "off": 144 },
    { "struct": "WRITE_BEGIN_REQ", "field": "transport", "off": 8, "size": 9 },
    { "struct": "WRITE_BEGIN_REQ", "field": "crc", "off": 9, "vsize": 13 },
