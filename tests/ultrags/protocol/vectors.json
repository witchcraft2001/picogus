  "z80": {
    "comment": "Expected deposits for tests/ultrags/protocol/z80-vectors.asm executing on the pinned Z80 core (harness reads OUT area at 0xA000). All expected bytes handwritten/independent; CRC values cross-checked vs zlib.crc32, never produced by the ASM under test.",
    "out_base": "0xA000",
    "frame_base_off": 96,
    "frame_stride": 140,
    "crc_slots": [
      { "off": 0, "expect": "26 39 F4 CB", "what": "crc32(\"123456789\") = CBF43926" },
      { "off": 4, "expect": "13 86 B9 8B", "what": "crc32(00 01 02 03) = 8BB98613" },
      { "off": 8, "expect": "B4 8A 5A 7A", "what": "crc32(80 00) = 7A5A8AB4" },
      { "off": 12, "expect": "00 00 00 FF", "what": "crc32(FF) = FF000000" },
      { "off": 16, "expect": "00 00 00 00", "what": "crc32(empty) = 00000000" },
      { "off": 20, "expect": "26 39 F4 CB", "what": "streaming INIT+FOLD(1234)+FOLD(56789)+END = CBF43926" }
    ],
    "le16": { "off": 32, "expect": "01 00 FF 00 00 01 FF 7F 00 80 FF FF" },
    "le32": { "off": 48, "expect": "00 00 00 00 00 00 01 00 00 00 10 00 FF FF 7F 00 FF FF FF FF" },
    "le64": { "off": 72, "expect": "08 07 06 05 04 03 02 01" },
    "get16": { "off": 80, "expect": "01 00" },
    "get32": { "off": 82, "expect": "00 00 10 00" },
    "frame_slots": [
      { "slot": 0, "vector": "info_fast" },
      { "slot": 1, "vector": "write_begin_fast_h1234" },
      { "slot": 2, "vector": "write_begin_verified" },
      { "slot": 3, "vector": "write_end_fast_tok1" },
      { "slot": 4, "vector": "read_begin_fast" },
      { "slot": 5, "vector": "read_begin_verified" },
      { "slot": 6, "vector": "read_end_fast" },
      { "slot": 7, "vector": "read_end_verified_tok1" },
      { "slot": 8, "vector": "alloc_raw_4k" },
      { "slot": 9, "vector": "seal_h1_noflags" },
      { "slot": 10, "vector": "pcm_config_44100_s16le_stereo" },
      { "slot": 11, "vector": "object_info_h1" },
      { "slot": 12, "vector": "mem_info" },
      { "slot": 13, "vector": "caps" },
      { "slot": 14, "vector": "stats" },
      { "slot": 15, "vector": "snapshot" },
      { "slot": 16, "vector": "transfer_cancel" },
      { "slot": 17, "vector": "queue_add" },
      { "slot": 18, "vector": "info_crc" },
      { "slot": 19, "vector": "stats_crc" },
      { "slot": 20, "vector": "write_begin_frame_crc" },
      { "slot": 21, "vector": "frame_128_crc" },
      { "slot": 22, "expect_err": 1, "what": "opcode 0x80 arg error -> CF=1" },
      { "slot": 23, "expect_err": 1, "what": "payload len 129 arg error -> CF=1" }
    ]
  },
  "negative": [
    { "name": "len_129_fault", "kind": "frame", "header": "00 81", "expect": "FAULT:LENGTH", "note": "payload_length 129 -> FAULT, no reply until TRANSPORT_RESET" },
    { "name": "len_255_fault", "kind": "frame", "header": "00 FF", "expect": "FAULT:LENGTH" },
    { "name": "bad_opcode", "kind": "reply_error", "opcode": "0x7F", "payload": "", "expect": "0x01", "note": "BAD_OPCODE reply (no frame CRC)" },
    { "name": "bad_opcode_crc_req", "kind": "reply_error", "opcode": "0x7F", "payload": "", "frame_crc": true, "expect": "0x01" },
    { "name": "info_extra_payload", "kind": "reply_error", "opcode": "0x00", "payload": "AA", "expect": "0x03", "note": "INFO takes empty payload -> LENGTH" },
    { "name": "write_begin_short_payload", "kind": "reply_error", "opcode": "0x20", "payload": "34 12 00", "expect": "0x03" },
    { "name": "bad_frame_crc", "kind": "reply_error", "opcode": "0x00", "payload": "", "frame_crc": true, "corrupt_crc": true, "expect": "0x04", "note": "CRC error" },
    { "name": "bad_transport", "kind": "reply_error", "opcode": "0x20", "payload": "34 12 00 00 00 00 00 04 02", "expect": "0x02", "note": "transport=2 invalid -> BAD_ARGUMENT" },
    { "name": "xfer_len_0", "kind": "reply_error", "opcode": "0x20", "payload": "34 12 00 00 00 00 00 00 00", "expect": "0x03", "note": "N=0 -> LENGTH" },
    { "name": "xfer_len_1025", "kind": "reply_error", "opcode": "0x20", "payload": "34 12 00 00 00 00 01 04 00", "expect": "0x03", "note": "N=1025 -> LENGTH" },
    { "name": "alloc_kind_4", "kind": "reply_error", "opcode": "0x10", "payload": "04 00 10 00 00", "expect": "0x02" },
    { "name": "alloc_size_0", "kind": "reply_error", "opcode": "0x10", "payload": "01 00 00 00 00", "expect": "0x03" },
    { "name": "free_bad_handle", "kind": "reply_error", "opcode": "0x11", "payload": "34 12", "expect": "0x07", "note": "unknown handle -> HANDLE" },
    { "name": "snap_index_128", "kind": "reg_write", "reg": "0x04", "value": "0x80", "expect": "X_ERROR=0x08", "note": "SNAP_INDEX>127 -> RANGE" },
    { "name": "ctrl_bad_value", "kind": "reg_write", "reg": "0x02", "value": "0x55", "expect": "X_ERROR=0x02", "note": "unknown X_CONTROL -> BAD_ARGUMENT" },
    { "name": "write_xstatus", "kind": "reg_write", "reg": "0x01", "value": "0x00", "expect": "X_ERROR=0x14", "note": "write to read-only -> BAD_REGISTER" },
    { "name": "empty_read", "kind": "reg_read", "reg": "0x03", "expect": ["0xFF", "X_ERROR=0x0F"], "note": "X_RESPONSE empty -> FFh + UNDERFLOW" },
    { "name": "reset_store_bad_key", "kind": "reply_error", "opcode": "0x06", "payload": "FF FF FF FF 00", "expect": "0x02", "note": "wrong key -> BAD_ARGUMENT" }
  ]
}
